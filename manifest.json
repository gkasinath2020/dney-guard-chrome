{
  "manifest_version": 3,
  "name": "DNey Guard: AI guardrails for ChatGPT and Claude",
  "version": "0.3.6",
  "description": "Checks what you send to ChatGPT and Claude for personal data, API keys and prompt injection, then masks or blocks it.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://claude.ai/*", "https://chatgpt.com/*", "https://api.dney.dev/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "DNey Guard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "ui/options.html",
  "content_scripts": [
    { "matches": ["https://claude.ai/*", "https://chatgpt.com/*"], "js": ["content/main.js"], "run_at": "document_start" },
    { "matches": ["https://claude.ai/*", "https://chatgpt.com/*"], "js": ["content/page-hook.js"], "run_at": "document_start", "world": "MAIN" }
  ],
  "storage": { "managed_schema": "managed_schema.json" }
}
